# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is gitignored — never commit real credentials.

[snowflake]
account   = "WEDSQVX-PATTERN"
user      = "MAX.THOMAS@PATTERN.COM"
warehouse = "ACCOUNTING_FINANCE_TEAM_WH"
database  = "ANALYTICS_DB"
schema    = "PUBLIC"

# For local SSO (browser popup): leave authenticator as "externalbrowser"
# For a service account (deployed/headless): use "snowflake" and set password below
authenticator = "externalbrowser"
# password = "..."
